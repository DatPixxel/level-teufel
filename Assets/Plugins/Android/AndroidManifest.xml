<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml für Sherlock: Hidden Evidence & Mystery Merge

  Wichtige Einstellungen:
  • android:minSdkVersion="24"  → Android 7.0+ (2017) — breite Geräteunterstützung
  • android:targetSdkVersion="34" → Android 14 — Google Play Anforderung 2024
  • Berechtigungen: nur Vibration (kein Internet nötig — REST wird erst bei Leaderboard gebraucht)
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.DEINNAME.sherlockmerge">

    <!-- ── Berechtigungen ───────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />       <!-- Leaderboard / IAP -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Geräteanforderungen ──────────────────────────────────────────── -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="true" />

    <!-- ── App-Konfiguration ────────────────────────────────────────────── -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/app_icon"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="false">

        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Unterstützt Cutout-Displays (Punch-Hole, Notch) ab Android 9 -->
            <meta-data
                android:name="android.notch_support"
                android:value="true" />
        </activity>

        <!-- Google Play Billing (IAP) — wird von Unity IAP automatisch hinzugefügt -->
        <!-- Falls manuell nötig: -->
        <!--
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        -->
    </application>

    <!-- SDK-Versionen (wird von Unity Player Settings überschrieben — hier als Referenz) -->
    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

</manifest>
